#nop TorilMUD Helper Bot, for use with gobot executable

#CONFIG		{AUTO TAB}		{5000}
#CONFIG		{BUFFER SIZE}	{100000}
#CONFIG		{CHARSET}		{ASCII}
#CONFIG		{CONNECT RETRY}	{360}
#CONFIG		{COMMAND COLOR}	{<078>}
#CONFIG		{COMMAND ECHO}	{ON}
#CONFIG		{HISTORY SIZE}	{2500}
#CONFIG		{LOG}			{RAW}
#nop Without packet patch, some text disappears.
#nop With a high value, the prompt gets overwritten.
#CONFIG		{PACKET PATCH}	{0.05}
#CONFIG		{REPEAT ENTER}	{ON}
#CONFIG		{REPEAT CHAR}	{!}
#CONFIG		{SCROLL LOCK}	{ON}
#CONFIG		{SPEEDWALK}		{ON}
#CONFIG		{TINTIN CHAR}	{#}
#CONFIG		{VERBATIM}		{OFF}
#CONFIG		{VERBATIM CHAR}	{\}
#CONFIG		{VERBOSE}		{OFF}
#CONFIG		{WORDWRAP}		{OFF}
#PATHDIR	{n}		{s}		{1}
#PATHDIR	{e}		{w}		{2}
#PATHDIR	{s}		{n}		{4}
#PATHDIR	{w}		{e}		{8}
#PATHDIR	{u}		{d}		{16}
#PATHDIR	{d}		{u}		{32}


#nop tokens.tin sets the following variables to correct info
#var {acct} {Account}
#var {char} {Character}
#var {cpw} {Password}
#class tokens read tokens.tin


#var {dot} {.}

#nop #script and #system hand their command line to /bin/sh, so any MUD text
#nop put on that line must be made shell-safe first. Inside "double quotes"
#nop sh only treats " ` $ and \ specially, so neutralize exactly those and
#nop always put the variable inside double quotes. Usage: shellsafe <varname>
#alias {shellsafe %1} {
	#replace {%1} {"} {'};
	#replace {%1} {`} {'};
	#replace {%1} {\$} {};
	#replace {%1} {\\} {};
}

#alias {logon} {
	#format {logdate} {%t} {%Y.%m.%d};
	#log append logs/$char$dot$logdate${dot}log;
}
#nop Answer the login prompts one at a time: the account when the MUD asks
#nop for it, the password only at its own prompt and the character at the
#nop menu. A first line the MUD garbles only gets the account asked for
#nop again, so the password never goes out at the account prompt. The
#nop account goes out a second after its prompt, unless the next prompt
#nop comes first. After three tries at the account, or a minute without
#nop reaching the menu, the session is zapped and logs back in. A password
#nop turned down twice stops the logins (loginstop).
#var {ingame} {0}
#alias {login} {
	#var {acctsent} {0};
	#var {pwsent} {0};
	#var {ingame} {0};
	#var {inworld} {0};
	#act {^Account name:} {
		#if {$pwsent >= 2} {loginstop} {
			#if {$acctsent >= 3} {#zap} {
				#if {$acctsent == 0} {
					logon;
					#delay {loginwatch} {#zap} {60}
				};
				#math {acctsent} {$acctsent + 1};
				#delay {sendacct} {$acct} {1}
			}
		}
	};
	#act {^Password:} {
		#undelay {sendacct};
		#math {pwsent} {$pwsent + 1};
		$cpw
	};
	#act {^Your choice:} {
		#undelay {sendacct};
		#undelay {loginwatch};
		#unact {^Account name:};
		#unact {^Password:};
		#unact {^Your choice:};
		#var {ingame} {1};
		$char;
		time
	};
	#session $char torilmud.com 9999;
	#split {0} {0};
}
#nop Trying a password the MUD has turned down twice can only lock the
#nop account, so close the session without logging back in.
#alias {loginstop} {
	#unevent {SESSION DISCONNECTED};
	#showme {The MUD turned down the password twice, so Katumi won't log back in. Put the right one in tokens.tin and restart tintin.};
	#zap
}
#nop time and who only once the character is in, so that nothing else
#nop reaches the MUD while the login answers its prompts.
#tick {Timer} {#if {$ingame} {time;who}} {30}
#nop Capture digits only, so nothing but H:M:S can reach the shell. seen is
#nop when the line came in, in Unix seconds: gobot times the boot by it,
#nop however long the check then waits to run. The first answer after a
#nop login also shows the character is in the game (inworld).
#act {^Time elapsed since boot-up: %d:%d:%d} {#var {inworld} {1};#format {seen} {%T};#system gobot -time %1:%2:%3 -seen $seen &}
#nop Add who's count of players online to the hour, digits only as well
#act {^Total players online: %d} {#system gobot -online %1 &}

#event {PROGRAM START} {login}
#nop Log back in 5 seconds after a disconnect or a failed connect. The #delay
#nop has to live in the startup session (#gts): calling login straight from
#nop these events nests every retry inside the last failed one until tintin
#nop runs out of stack.
#event {SESSION DISCONNECTED} {#gts {#delay {relogin} {login} {5}}}
#event {SESSION TIMED OUT} {#gts {#delay {relogin} {login} {5}}}
#nop Back up toril.db at midnight, once, in the game or not. tintin fires a
#nop time event in every session that has it, and the MUD's session starts
#nop with a copy of the startup session's events, so it drops its copy of
#nop this one as soon as it's made.
#event {DAY} {#system gobot -bak}
#event {SESSION CREATED} {#unevent {DAY}}
#nop The MUD says this when the character sent at the menu doesn't exist.
#nop It zaps only until the character is in the game (inworld), since
#nop after that the same words said on a channel would knock Katumi
#nop offline. ingame, set at the menu, comes too early for this.
#var {inworld} {0}
#act {That character doesn't exist! Please try again.} {#if {$inworld == 0} {#delay 3 #zap}}


#nop Tells run at priority 4, ahead of every other trigger at the default 5.
#nop tintin fires only the first action that matches a line, so a tell
#nop quoting another trigger's words would go to that trigger instead.
#act {^%w tells you '%2'$} {
	#format {time} {%t} {%F %T};
	#line log {logs/tells.log} {$time - %0};

	#var {chat} {%2};
	#nop Prevent script hacking;
	shellsafe chat;
	#nop Remove account labeling;
	#replace {chat} {@} {};
	#script {answer} {gobot -char "%1" -tell "$chat"};
	#foreach {$answer} {cmd} {
		#if {"$cmd" != "%d"} {$cmd};
	};
} {4}
#act {^You tell %w '%2'$} {
	#format {time} {%t} {%F %T};
	#line log {logs/tells.log} {$time - %0};
}
#act {No-one by that name here...$} {
	#format {time} {%t} {%F %T};
	#line log {logs/tells.log} {$time - %0};
}


#nop Batch Who Check
#alias {parsewho} {shellsafe ppl;#script {who} {gobot -who "$ppl"}}
#act {^-=-=-=-=-=-=-=-=-=-=-=-=-$} {
	#act {^$} {
		#unact {%%%0};
		#unact {^$};
		#replace {ppl} { (AFK)} {};
		#replace {ppl} { (RP)} {};
		#replace {ppl} {(inv) } {};
		#replace {ppl} {(In Dark)} {};
		#replace {ppl} {(Daylight)} {};
		parsewho;
		#foreach {$who} {cmd} {
			#if {"$cmd" != "%d"} {$cmd};
		};
		#var {who} {};
	}{2};
	#var {ppl} {};
	#var {who} {};
	#act {%%0} {
		#var {ppl} {$ppl|%%0};
	}{3};
}{5}

#nop Individual Checks
#act {^[ %d %+] %w %*(%*) (@%*)} {
	#var {wclass} {%2};
	#var {race} {%5};
	#replace {race} {)%*} {};
	#var {wacct} {%6};
	shellsafe wclass;
	shellsafe race;
	shellsafe wacct;
	#script {answer} {gobot -char "%3" -class "$wclass" -lvl "%1" -race "$race" -acct "$wacct"};
	#foreach {$answer} {cmd} {
		#if {"$cmd" != "%d"} {$cmd};
	};
}
#act {^[%.%. %+] %w %*(%*) (@%*)} {
	#var {wlvl} {%1%2};
	#replace {wlvl} { } {};
	#var {wclass} {%3};
	#var {race} {%6};
	#replace {race} {)%*} {};
	#var {wacct} {%7};
	shellsafe wlvl;
	shellsafe wclass;
	shellsafe race;
	shellsafe wacct;
	#script {answer} {gobot -char "%4" -class "$wclass" -lvl "$wlvl" -race "$race" -acct "$wacct"};
	#foreach {$answer} {cmd} {
		#if {"$cmd" != "%d"} {$cmd};
	};
}

